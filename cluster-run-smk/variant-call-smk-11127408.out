    resources: tmpdir=/tmp, mem_mb=2000, mem=2 GB, mem_mib=1908, disk_mb=1000, disk=1 GB, disk_mib=954, slurm_account=binf6610.202710, slurm_partition=courses, runtime=30
Shell command: 
        printf 'sample_id\tcondition\n' > results/samples.tsv
        awk -F, 'NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; next }
                 { print $col["sample_id"] "\t" $col["condition"] }' work/validate/samplesheet.csv >> results/samples.tsv

        # The manifest checksums copies of exactly what this run published.
        rm -rf work/publish && mkdir -p work/publish/published
